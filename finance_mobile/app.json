{
  "expo": {
    "name": "Pilotage Finances",
    "slug": "finance_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "finance-app",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pilotagefinances.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.pilotagefinances.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'accès à vos photos permet de scanner vos factures.",
          "cameraPermission": "L'accès à la caméra permet de photographier vos factures."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "L'accès à la caméra permet de photographier vos factures."
        }
      ]
    ]
  }
}
