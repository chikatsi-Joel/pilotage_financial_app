{
  "expo": {
    "name": "Lucia",
    "slug": "finance_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "finance-app",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pilotagefinances.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.pilotagefinances.app",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'accès à vos photos permet de scanner vos factures.",
          "cameraPermission": "L'accès à la caméra permet de photographier vos factures."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "L'accès à la caméra permet de photographier vos factures."
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#584CB9",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "db7170ab-f413-456f-b79b-6faa8554737d"
      }
    },
    "owner": "gradi_jo"
  }
}
