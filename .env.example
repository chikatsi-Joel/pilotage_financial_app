APP_NAME=personal-finance-pilotage-api
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://finance:finance@localhost:5432/finance
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
ANALYTICS_LOOKBACK_MONTHS=6
MIN_HISTORY_MONTHS_FOR_BASELINE=3
ATTENTION_DEVIATION_THRESHOLD=0.20
STRONG_DEVIATION_THRESHOLD=0.50
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT=60.0
OLLAMA_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
