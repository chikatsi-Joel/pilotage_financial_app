# Copier en .env sur la VM (jamais commité) puis remplir les valeurs marquées « à remplir ».

# Domaine HTTPS : l'IP publique avec des tirets + .sslip.io (aucun achat de domaine nécessaire).
DOMAIN=1-2-3-4.sslip.io

# Mot de passe Postgres (généré par setup.sh).
POSTGRES_PASSWORD=

# Chiffrement des secrets du backoffice (généré par setup.sh).
SETTINGS_SECRET_KEY=

# E-mails (codes à 6 chiffres).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=kappachikatsi@gmail.com
# à remplir : mot de passe d'application Gmail (pas de commentaire sur la même ligne qu'une valeur)
SMTP_PASSWORD=
SMTP_FROM=Lucia
SMTP_SECURITY=starttls

# IA : la clé Ollama se saisit de préférence dans le backoffice (Configuration).
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT=180

# Analyse
ANALYTICS_LOOKBACK_MONTHS=3
MIN_HISTORY_MONTHS_FOR_BASELINE=2
ATTENTION_DEVIATION_THRESHOLD=0.20
STRONG_DEVIATION_THRESHOLD=0.50
